    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[1]._dialogues.Array.data[2]._content
      value: WAIT. Don't tell me you actually liked that ending?
