    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[20]._dialogues.Array.data[3]._content
      value: You should post something. I'll even share it!
