    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[0]._options.Array.data[0].text
      value: 'Safe: Use a username and avatar only.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[0]._options.Array.data[1].text
      value: 'Neutral: Add a first name and selfie.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[0]._options.Array.data[2].text
      value: 'Risky: Add full name, school and photo.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._options.Array.data[0].text
      value: 'Safe: Keep the conversation about books.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._options.Array.data[1].text
      value: 'Neutral: Share hobbies and interests.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._options.Array.data[2].text
      value: 'Risky: Share school, routine and location.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[9]._options.Array.data[0].text
      value: 'Safe: Keep it about the books.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[9]._options.Array.data[1].text
      value: 'Neutral: Say you''re a book nerd.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[9]._options.Array.data[2].text
      value: 'Risky: Share school, routine and location.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[16]._options.Array.data[0].text
      value: 'Safe: Could you just leave me alone?'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[16]._options.Array.data[1].text
      value: 'Neutral: Ignore them and quietly get your books.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[16]._options.Array.data[2].text
      value: 'Risky: At least I don''t spend all day obsessing over other people.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[20]._options.Array.data[0].text
      value: 'Safe: Post about a favourite book.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[20]._options.Array.data[1].text
      value: 'Neutral: Post a selfie without details.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[20]._options.Array.data[2].text
      value: 'Risky: Show uniform and location.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[24]._options.Array.data[0].text
      value: 'Safe: Save evidence, report it and seek help.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[24]._options.Array.data[1].text
      value: 'Neutral: Delete the original and log off.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[24]._options.Array.data[2].text
      value: 'Risky: Comment back and argue.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[32]._options.Array.data[0].text
      value: 'Safe: I''d rather not share personal information.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[32]._options.Array.data[1].text
      value: 'Neutral: Why do you ask?'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[32]._options.Array.data[2].text
      value: 'Risky: Tell Noah her age and other personal details.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[36]._options.Array.data[0].text
      value: 'Safe: Refuse, block and report Noah.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[36]._options.Array.data[1].text
      value: 'Neutral: Send a normal selfie.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[36]._options.Array.data[2].text
      value: 'Risky: Send a flirty or revealing selfie.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[40]._options.Array.data[0].text
      value: 'Safe: Save evidence, report, block and tell a trusted adult.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[40]._options.Array.data[1].text
      value: 'Neutral: Block Noah and close the app without telling anyone.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[40]._options.Array.data[2].text
      value: 'Risky: Ignore the post and hope it disappears.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[48]._options.Array.data[0].text
      value: 'Safe: Block, report and tell someone about the messages.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[48]._options.Array.data[1].text
      value: 'Neutral: Ask how the account knows before deciding what to do.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[48]._options.Array.data[2].text
      value: 'Risky: Share where she walks and when she gets home.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[52]._options.Array.data[0].text
      value: 'Safe: Go private, remove identifying information and review location permissions.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[52]._options.Array.data[1].text
      value: 'Neutral: Delete a few posts that reveal personal information.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[52]._options.Array.data[2].text
      value: 'Risky: Leave everything public.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[59]._options.Array.data[0].text
      value: 'Safe: Save evidence, report the misinformation and speak to someone she trusts.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[59]._options.Array.data[1].text
      value: 'Neutral: Ignore the post and stop checking the comments.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[59]._options.Array.data[2].text
      value: 'Risky: Publicly confront everyone sharing the post.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[63]._options.Array.data[0].text
      value: 'Safe: Refuse to share more information and seek help from a trusted adult.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[63]._options.Array.data[1].text
      value: 'Neutral: Ask exactly who will receive the information and why.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[63]._options.Array.data[2].text
      value: 'Risky: Send the screenshots and account details without checking.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[67]._options.Array.data[0].text
      value: 'Safe: Reach out, preserve evidence, report harmful accounts and secure her privacy.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[67]._options.Array.data[1].text
      value: 'Neutral: Take a break and avoid strangers, but keep everything to herself.'
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[67]._options.Array.data[2].text
      value: 'Risky: Continue using Connect normally and hope it goes away.'
      objectReference: {fileID: 0}
