      propertyPath: _inspectorNarrativeNodes.Array.data[4]._dialogues.Array.data[0]._content
      value: Hey! Saw your comment about Lost Cause.
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._dialogues.Array.data[1]._content
      value: Finally someone who understands how good that book is.
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._dialogues.Array.data[2]._content
      value: The ending was actually insane.
      objectReference: {fileID: 0}
    - target: {fileID: 4398672150626424371, guid: 5988493fe5441904b9c668d6bff4eb52, type: 3}
      propertyPath: _inspectorNarrativeNodes.Array.data[4]._dialogues.Array.data[3]._content
      value: You know, you're actually really fun to talk to. Tell me about yourself?
      objectReference: {fileID: 0}
